              "type": "string",
              "description": "Minimum price",
              "example": 52
            }
          },
          {
            "description": "Maximum price",
            "example": 400,
            "in": "query",
            "name": "maxPrice",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Maximum price",
              "example": 400
            }
          },
          {
            "description": "Page number",
