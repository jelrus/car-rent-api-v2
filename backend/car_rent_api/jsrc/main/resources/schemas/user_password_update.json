{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "newPassword": {
    "type": "string",
    "description": "User's new password",
    "pattern": "^(?=.*[A-Z])(?=.*[a-z])(?=.*\\d).{8,}$",
    "minLength": 1,
    "example": "&Q5m#9bX^d8!FwZ2"
  },
  "oldPassword": {
    "type": "string",
    "description": "User's old password",
    "pattern": "^(?=.*[A-Z])(?=.*[a-z])(?=.*\\d).{8,}$",
    "minLength": 1,
    "example": "&Q5m#9bX^d8!FwZ2"
  },
  "required": ["newPassword", "oldPassword"]
}