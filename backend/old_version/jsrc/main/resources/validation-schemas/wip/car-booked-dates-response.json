{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "Payload for booked date response",
  "properties": {
    "content": {
      "type": "array",
      "description": "List of booked dates",
      "example": [
        "2024-06-08",
        "2024-06-09"
      ],
      "items": {
        "type": "string",
        "description": "List of booked dates",
        "example": "[\"2024-06-08\",\"2024-06-09\"]"
      }
    }
  }
}