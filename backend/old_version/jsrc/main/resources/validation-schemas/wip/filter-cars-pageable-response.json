{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "Payload for car filter pageable response",
  "properties": {
    "content": {
      "type": "array",
      "items": {
        "$ref": "/validation-schemas/wip/car-brief-info.json"
      }
    },
    "currentPage": {
      "type": "integer",
      "description": "Current page",
      "format": "int32",
      "example": 1
    },
    "totalElements": {
      "type": "integer",
      "description": "Total elements",
      "format": "int64",
      "example": 16
    },
    "totalPages": {
      "type": "integer",
      "description": "Total pages",
      "format": "int32",
      "example": 2
    }
  }
}