{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
			"@public/*": ["public/*"],
      "@/*": ["src/*"],
			"@components/*": ["src/components/*"],
			"@assets/*": ["src/assets/*"],
			"@containers/*": ["src/containers/*"],
			"@hooks/*": ["src/hooks/*"],
			"@pages/*": ["src/pages/*"],
			"@redux/*": ["src/redux/*"],
			"@stories/*": ["src/stories/*"],
			"@utils/*": ["src/utils/*"]
    }
  }
}